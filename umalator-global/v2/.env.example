# V2 Environment Variables
# Copy this file to .env.local and fill in your actual values
# .env.local is gitignored and will never be committed

# Discord webhook URL for feedback submissions (optional)
# Create a webhook in Discord: Server Settings → Integrations → Webhooks
VITE_DISCORD_WEBHOOK=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Feedback drawer feature flag (optional, default: enabled)
# Set to "false" to hide the in-app feedback drawer + floating button entirely.
# Auto-hidden when VITE_DISCORD_WEBHOOK is empty.
# VITE_ENABLE_FEEDBACK=true

# Cloudflare Turnstile sitekey (public) for the OCR proxy abuse gate.
# Get from Cloudflare dashboard → Turnstile. Local dev: 1x00000000000000000000AA (always passes).
TURNSTILE_SITEKEY=
