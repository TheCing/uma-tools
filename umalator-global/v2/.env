# Committed build defaults for all environments.
# Override locally via .env.local (gitignored) or in Cloudflare Pages env vars.
# Secrets do NOT belong here — only .env.local / Cloudflare Pages settings.

# Feedback drawer feature flag. Set to "false" to hide the in-app feedback
# drawer + floating button. Auto-disabled if VITE_DISCORD_WEBHOOK is empty.
VITE_ENABLE_FEEDBACK=false
