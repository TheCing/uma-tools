# Cloudflare Pages redirect rules -- SUNSET (2026-11)
#
# Umalator is retired. The root serves the farewell page (sunset/index.html, copied
# to /index.html by build-all.sh), and every app path below is sent there.
#
# These are 302s on purpose, not 301s: browsers cache a 301 indefinitely, so if the
# site is ever revived these would keep bouncing returning users for months.
#
# Each prefix gets an exact rule plus a splat rule. There is deliberately no global
# /* catch-all: it would also match / and loop, and it would redirect the farewell
# page's own assets. Pages applies _redirects BEFORE static files (verified against
# prod: /umalator-global/v2/ still has an index.html in git yet redirects), so the
# app bundles still in the repo are unreachable without deleting any source.
#
# To revive: restore the pre-sunset _redirects and build-all.sh from git history.

# Kept: the farewell page loads its sprite and font through the /uma-tools/ prefix.
/uma-tools/* /:splat 200

/umalator-global / 302
/umalator-global/* / 302
/umalator / 302
/umalator/* / 302
/v2 / 302
/v2/* / 302
/skill-visualizer / 302
/skill-visualizer/* / 302
/skill-visualizer-jp / 302
/skill-visualizer-jp/* / 302
/skill-visualizer-global / 302
/skill-visualizer-global/* / 302
/mechanics-explorer / 302
/mechanics-explorer/* / 302
/hp-calculator / 302
/hp-calculator/* / 302
/events / 302
/events/* / 302
/team-trials / 302
/team-trials/* / 302
/release-timeline / 302
/release-timeline/* / 302
/build-planner / 302
/build-planner/* / 302
/canva / 302
