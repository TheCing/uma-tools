# Moomoolator is retired (2026-11) and kept online as an unmaintained archive of the
# main simulator only. Every sub-app sends visitors to the notice at /retired/.
# 302, not 301, so a future change isn't stuck in browser caches.
# Rules match top to bottom: keep the simulator's own aliases ABOVE the /umalator-global
# catch-all. Pages Functions run before this file (see functions/), so /canva and
# /events are also handled there.

# Asset prefix the simulator uses for icons/fonts.
/uma-tools/* /:splat 200

# Old simulator URLs -> the simulator at the root (keeps old #H4sI share links working).
/umalator-global/v2/* /:splat 301
/v2/* /:splat 301

# Retired sub-apps -> notice page.
/skill-visualizer /retired/ 302
/skill-visualizer/* /retired/ 302
/skill-visualizer-jp /retired/ 302
/skill-visualizer-jp/* /retired/ 302
/skill-visualizer-global /retired/ 302
/skill-visualizer-global/* /retired/ 302
/mechanics-explorer /retired/ 302
/mechanics-explorer/* /retired/ 302
/hp-calculator /retired/ 302
/hp-calculator/* /retired/ 302
/events /retired/ 302
/events/* /retired/ 302
/team-trials /retired/ 302
/team-trials/* /retired/ 302
/release-timeline /retired/ 302
/release-timeline/* /retired/ 302
/build-planner /retired/ 302
/build-planner/* /retired/ 302
/canva /retired/ 302
/canva/* /retired/ 302
/docs /retired/ 302
/docs/* /retired/ 302
/courseimages /retired/ 302
/courseimages/* /retired/ 302
/umalator-global/skill-visualizer /retired/ 302
/umalator-global/skill-visualizer/* /retired/ 302
/umalator-global/mechanics-explorer /retired/ 302
/umalator-global/mechanics-explorer/* /retired/ 302

# Retired v1 simulators -> the simulator at the root.
/umalator-global / 301
/umalator-global/* / 301
/umalator / 301
/umalator/* / 301
