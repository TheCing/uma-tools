# Cloudflare Pages redirect rules

# Redirect www to non-www (canonical)
https://www.umalator.app/* https://umalator.app/:splat 301

# Redirect root to umalator-global
/ /umalator-global/ 301

# Redirect /events/:id to /events/ (deep links handled by OG function for bots)
/events/:id /events/ 302

# Rewrite /uma-tools/* paths to root for compatibility with GitHub Pages paths
/uma-tools/* /:splat 200
