node_modules/
.DS_Store

# Environment variables — only *.local files are gitignored (Vite convention).
# Base .env and per-mode .env.[mode] are committed for shared build defaults.
.env.local
.env.*.local

# Build outputs
**/dist/
/assets/
/simulator.worker.js
# umalator-global/not-in-game.json is now committed.
# It is regenerated locally from docs/master.mdb via `node umalator-global/build.mjs`;
# deploys read the committed version directly (master.mdb is not deployed).

# Discord bot — source is kept out of the public repo (deployed directly to
# Railway). A few files (package.json, package-lock.json, tsconfig.json,
# src/gemini-ocr.ts) were committed earlier and stay tracked; this rule only
# stops NEW bot files from being swept in by `git add`. Already-tracked files
# are unaffected by gitignore and can still be edited/committed normally.
/uma-tools-bot/

# Large media files
videos/
# Raw game exports (training logs, UmaExtractor dumps) can contain LIVE CREDENTIALS —
# steam_session_ticket, steam_id, viewer_id. Never commit them.
# Drop personal samples in docs/private/ instead; it is ignored wholesale.
/docs/private/
/docs/Oguri Cap*.json
